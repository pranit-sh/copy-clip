{
  "name": "Copy Clip — Clipboard for Chrome",
  "short_name": "Copy Clip",
  "description": "A fast, keyboard-first clipboard manager. Save, search, pin — one click to copy.",
  "version": "2.0.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "index.html",
    "default_icon": "icons/copy-clip-192.png",
    "default_title": "Copy Clip"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "clipboardWrite"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "Open Copy Clip"
    }
  },
  "icons": {
    "16":  "icons/copy-clip-192.png",
    "48":  "icons/copy-clip-192.png",
    "128": "icons/copy-clip-192.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
